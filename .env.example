# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# Fuente de datos: dian_portal | contingency | fake
RUT_SOURCE=fake

# URL del canal oficial (se confirma en la Fase 2; no asumir que la URL original funciona)
RUT_PORTAL_URL=

# Navegador visible en ejecución real (requerido para el modo asistido)
RUT_HEADLESS=false
RUT_NAVIGATION_TIMEOUT_S=30

# Ritmo responsable (nunca menos de 3 s)
RUT_MIN_DELAY_BETWEEN_QUERIES_S=5
RUT_MAX_RETRIES=2

# Tiempo que se espera a que el operador resuelva una verificación de seguridad
RUT_HUMAN_CHALLENGE_TIMEOUT_S=120

# Carpetas locales (ignoradas por git)
RUT_OUTPUT_DIR=output
RUT_LOG_DIR=logs
